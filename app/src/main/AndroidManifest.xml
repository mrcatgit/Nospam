<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      NoSpam usa SOLO permessi non invasivi.
      - READ_CALL_LOG / READ_CONTACTS: per distinguere chiamanti noti da ignoti e
        correlare gli eventi di screening (opzionali, richiesti a runtime).
      Nessun permesso di registrazione audio: l'app NON intercetta conversazioni.
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Registrazione della chiamata a cui l'utente partecipa (dal microfono, in vivavoce).
      Lecita in Italia per chi è parte della conversazione. NON dà accesso al flusso
      audio di rete (precluso alle app di terze parti da Android 10).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:name=".NoSpamApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoSpam">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NoSpam">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Servizio di screening ufficiale di Android. Il sistema lo invoca per ogni
          chiamata in arrivo quando NoSpam è impostata come "app ID chiamante & spam".
        -->
        <service
            android:name=".screening.NoSpamScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Registrazione audio della chiamata (avviata/fermata dall'utente). -->
        <service
            android:name=".recording.CallRecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
